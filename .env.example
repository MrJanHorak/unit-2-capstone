# Copy to .env and supply your own key. Never commit .env.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Space requests for the free tier; increase this if your account returns 429.
GEMINI_REQUEST_INTERVAL_SECONDS=7
# Optional paid-tier rates when changing models; both must be set, USD per million tokens.
# INPUT_USD_PER_MILLION=0.30
# OUTPUT_USD_PER_MILLION=2.50
