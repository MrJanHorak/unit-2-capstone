# ============================================================================
# Python Core & Bytecode
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================================================
# Virtual Environments & Environments
# ============================================================================
# Standard virtual environments
.venv/
venv/
ENV/
env/
pythonenv/

# Pipenv & Poetry (lock files are optional, but environment paths should be ignored)
.venv
.poetry/

# pyenv configuration (optional: comment out if team must share python version)
.python-version

# ============================================================================
# Sensitive & Configuration Files (Never commit credentials)
# ============================================================================
.env
.env.*
!.env.example
*.secret
secrets.json

